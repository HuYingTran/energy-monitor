# SQLite — file DB nằm trong thư mục backend/
SQLITE_PATH=energy_monitor.db

# InfluxDB — dùng chung container `influxdb` có sẵn trên máy
INFLUX_URL=http://localhost:8086
INFLUX_ORG=
INFLUX_BUCKET=energy-monitor
INFLUX_TOKEN=

# MQTT — dùng chung container `emqx` có sẵn trên máy (anonymous, dev only)
MQTT_HOST=localhost
MQTT_PORT=1883

# Backend
API_CORS_ORIGINS=http://localhost:5173
